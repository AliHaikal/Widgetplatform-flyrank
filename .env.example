# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Database -------------------------------------------------------------
DATABASE_URL=sqlite:///./widgetplatform.db

# --- Owner authentication -------------------------------------------------
# supabase (default): verify the bearer token against your Supabase project.
# dev: LOCAL DEMO/TEST ONLY. Tokens are "dev:<tenant>", e.g. "dev:tenant-a".
AUTH_MODE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key

# --- Abuse protection -----------------------------------------------------
RATE_LIMIT_PER_IP=10/minute
RATE_LIMIT_PER_WIDGET=120/minute
MAX_BODY_BYTES=10000
# Only set to 1 when running behind a proxy you control (it sets X-Forwarded-For).
TRUST_FORWARDED_FOR=0

# --- Geo enrichment (for a deterministic fallback proof) ---------------------
GEO_MOCK=0
GEO_A_DOWN=0
GEO_B_DOWN=0

# --- Confirmation email (fake: logged to the console) ------------------------
EMAIL_FAIL=0
EMAIL_RETRY_BASE_SECONDS=1
